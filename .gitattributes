*.sh text eol=lf
*.py text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
.env.example text eol=lf
.gitignore text eol=lf

*.csv binary
*.parquet binary
*.zip binary
*.png binary
*.jpg binary
*.ipynb -text
